MARKETFORGE_DATABASE_URL=postgres://marketforge:marketforge@127.0.0.1:55432/marketforge
MARKETFORGE_TEST_DATABASE_URL=postgres://marketforge:marketforge@127.0.0.1:55432/marketforge

# PostgreSQL uses one serialized write connection plus this many independent
# read connections. The default is 4; set 0 to route reads through the writer.
# MARKETFORGE_JOURNAL_READ_WORKERS=4

# The default single-active mode gives one process an exclusive PostgreSQL
# runtime lock. A standby may wait up to this many milliseconds.
# MARKETFORGE_RUNTIME_LOCK_WAIT_MS=0

# Set room-leased to run multiple active processes against one PostgreSQL
# database. It requires a unique instance ID and lock wait 0. Each process
# loads only rooms whose renewable writer leases it owns; non-owner requests
# return 409 until the current lease is released or expires.
# MARKETFORGE_RUNTIME_MODE=single-active
# MARKETFORGE_INSTANCE_ID=marketforge-a
# Public base URL returned by room owner discovery. It defaults to the bind URL
# when the server binds a concrete address; set it explicitly behind a proxy or
# when binding 0.0.0.0/::.
# MARKETFORGE_ADVERTISE_URL=https://marketforge-a.example.com
# MARKETFORGE_ROOM_LEASE_DURATION_MS=15000
# MARKETFORGE_ROOM_LEASE_RENEW_INTERVAL_MS=5000

# Loopback is the safe default when bearer authentication is not configured.
# MARKETFORGE_BIND_ADDR=127.0.0.1:57305

# Comma-separated browser origins allowed to call the API. Values must be
# complete http(s) origins without a path. Defaults to the two local Vite URLs.
# MARKETFORGE_CORS_ORIGINS=http://127.0.0.1:57304,http://localhost:57304

# For non-loopback binds, map opaque bearer tokens to user IDs. Replace the
# placeholder with a long random token; do not commit a real credential.
# MARKETFORGE_AUTH_TOKENS_JSON={"replace-with-a-long-random-token":"alice"}

# Optional CandleScope plugin remote mode. When unset, session.load continues
# to run the matching engine inside the plugin process. Set the URL to enable
# session.attach for an existing exchange-server room.
# MARKETFORGE_PLUGIN_BACKEND_URL=http://127.0.0.1:57305
# Use either a bearer token or the loopback-development user ID, never both.
# MARKETFORGE_PLUGIN_BACKEND_TOKEN=replace-with-a-long-random-token
# MARKETFORGE_PLUGIN_BACKEND_USER_ID=alice
# Multi-active deployments must explicitly allow every owner URL that may
# receive forwarded credentials after a 409 owner response.
# MARKETFORGE_PLUGIN_TRUSTED_OWNER_URLS=https://marketforge-a.example.com,https://marketforge-b.example.com

# Trusted bot packages: <directory>/<package>/bot.json + executable/script.
# Read once at startup; room requests select installed IDs, never commands.
# MARKETFORGE_BOT_PLUGIN_DIR=/absolute/path/to/MarketForge/bot-plugins
# Optional agent.v1 service settings (see docs/AI_TRADERS.md).
# MARKETFORGE_AGENT_OPERATOR_TOKEN=use-a-long-random-local-operator-token
# MARKETFORGE_AGENT_DOCKER_WSL=Ubuntu-22.04
# MARKETFORGE_AGENT_ADMIN_TOKEN=operator-only-exchange-bearer
# MARKETFORGE_TRADER_TOKEN_A=account-scoped-exchange-bearer
# Optional public RSS or SearxNG JSON search endpoint; {query} is URL-encoded.
# MARKETFORGE_AGENT_SEARCH_URL=https://www.bing.com/search?format=rss&q={query}
