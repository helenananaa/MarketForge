index 0000000..fb67ca1
--- /dev/null
+++ b/exchange-server/src/pine_inprocess/identity_cache.rs
@@ -0,0 +1,168 @@
+//! Bounded identity memoization. Full configuration and participant equality
+//! authorize a hit; the source belongs to the immutable Host program set.
+use super::{digest, io};
+use exchange_core::BotError;
+use serde_json::{Value, json};
+use std::{
+    collections::{BTreeMap, VecDeque},
+    sync::{Arc, Mutex},
+};
+
+struct Entry {
+    config: Value,
+    participant: Value,
+    digest: String,
+}
+
+// The Python-compatible identity distinguishes signed zero. Value's ordinary
+// numeric equality is insufficient to authorize reuse for configuration input.
+fn exact(left: &Value, right: &Value) -> bool {
+    match (left, right) {
+        (Value::Number(left), Value::Number(right)) if left.is_f64() && right.is_f64() => {
+            left.as_f64().unwrap().to_bits() == right.as_f64().unwrap().to_bits()
+        }
+        (Value::Array(left), Value::Array(right)) => {
+            left.len() == right.len() && left.iter().zip(right).all(|(a, b)| exact(a, b))
+        }
+        (Value::Object(left), Value::Object(right)) => {
+            left.len() == right.len()
+                && left.iter().all(|(key, value)| right.get(key).is_some_and(|other| exact(value, other)))
+        }
+        _ => left == right,
+    }
+}
+
+#[derive(Default)]
+pub(super) struct Cache {
+    entries: Mutex<Entries>,
+}
+
+#[derive(Default)]
+struct Entries {
+    values: BTreeMap<(String, String), Arc<Mutex<Option<Entry>>>>,
+    order: VecDeque<(String, String)>,
+}
+
+impl Cache {
+    pub(super) fn identity(
+        &self,
+        source: &str,
+        config: &Value,
+        participant: &Value,
+    ) -> Result<String, BotError> {
+        let compute =
+            || digest(&json!({"source":source,"config":config,"participant":participant}));
+        let (Some(room), Some(id)) = (
+            participant["room_id"].as_str(),
+            participant["participant_id"].as_str(),
+        ) else {
+            return compute();
+        };
+        let key = (room.to_owned(), id.to_owned());
+        // The shared map lock protects only lookup/eviction. Configuration
+        // comparison and cold hashing for one bot must not serialize other bots.
+        let slot = {
+            let mut entries = self.entries.lock().map_err(io)?;
+            if let Some(slot) = entries.values.get(&key) {
+                slot.clone()
+            } else {
+                while entries.values.len() >= 2048 {
+                    let oldest = entries.order.pop_front().unwrap();
+                    entries.values.remove(&oldest);
+                }
+                let slot = Arc::new(Mutex::new(None));
+                entries.order.push_back(key.clone());
+                entries.values.insert(key, slot.clone());
+                slot
+            }
+        };
+        let mut saved = slot.lock().map_err(io)?;
+        if let Some(entry) = saved.as_ref()
+            && exact(&entry.config, config)
+            && exact(&entry.participant, participant)
+        {
+            return Ok(entry.digest.clone());
+        }
+        let identity = compute()?;
+        *saved = Some(Entry {
+                config: config.clone(),
+                participant: participant.clone(),
+                digest: identity.clone(),
+            });
+        Ok(identity)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn signed_zero_configuration_changes_never_reuse_the_old_identity() {
+        let cache = Cache::default();
+        let participant = json!({"room_id":"room","participant_id":"id"});
+        let positive = json!({"inputs":{"nested":[0.0]}});
+        let negative = json!({"inputs":{"nested":[-0.0]}});
+        assert_eq!(positive, negative);
+        assert!(!exact(&positive, &negative));
+        let positive_digest = digest(&json!({"source":"fixed","config":positive,"participant":participant})).unwrap();
+        let negative_digest = digest(&json!({"source":"fixed","config":negative,"participant":participant})).unwrap();
+        assert_ne!(positive_digest, negative_digest);
+        for (config, expected) in [(&positive, &positive_digest), (&negative, &negative_digest), (&positive, &positive_digest)] {
+            assert_eq!(&cache.identity("fixed", config, &participant).unwrap(), expected);
+        }
+    }
+
+    #[test]
+    fn complete_config_and_participant_bind_hits_and_changes() {
+        let cache = Cache::default();
+        let participant = json!({"room_id":"room","participant_id":"id","account_id":1});
+        for config in [
+            json!({"script":"ma","inputs":{"Fast":2}}),
+            json!({"script":"rsi"}),
+            json!({"script":"ma","inputs":{"Fast":3}}),
+        ] {
+            for participant in [
+                participant.clone(),
+                json!({"room_id":"other","participant_id":"id","account_id":1}),
+                json!({"room_id":"room","participant_id":"id","account_id":2}),
+            ] {
+                let expected =
+                    digest(&json!({"source":"fixed","config":config,"participant":participant}))
+                        .unwrap();
+                assert_eq!(
+                    cache.identity("fixed", &config, &participant).unwrap(),
+                    expected
+                );
+                assert_eq!(
+                    cache.identity("fixed", &config, &participant).unwrap(),
+                    expected
+                );
+            }
+        }
+        assert_eq!(
+            cache.identity("fixed", &Value::Null, &Value::Null).unwrap(),
+            digest(&json!({"source":"fixed","config":null,"participant":null})).unwrap()
+        );
+    }
+
+    #[test]
+    fn eviction_is_bounded_and_recomputes_exactly() {
+        let cache = Cache::default();
+        let config = json!({"script":"ma"});
+        for index in 0..2050 {
+            let participant = json!({"room_id":"room","participant_id":index.to_string()});
+            let expected =
+                digest(&json!({"source":"fixed","config":config,"participant":participant}))
+                    .unwrap();
+            assert_eq!(
+                cache.identity("fixed", &config, &participant).unwrap(),
+                expected
+            );
+        }
+        let entries = cache.entries.lock().unwrap();
+        assert_eq!(entries.values.len(), 2048);
+        assert_eq!(entries.order.len(), 2048);
+        assert!(!entries.values.contains_key(&("room".into(), "0".into())));
+    }
+}
