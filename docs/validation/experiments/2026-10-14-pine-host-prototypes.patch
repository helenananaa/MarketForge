diff --git a/exchange-server/src/journal/scheduler_json/background.rs b/exchange-server/src/journal/scheduler_json/background.rs
new file mode 100644
index 0000000..65da3c7
--- /dev/null
+++ b/exchange-server/src/journal/scheduler_json/background.rs
@@ -0,0 +1,109 @@
+//! Optional ahead-of-writer encoding of immutable Pine state fragments.
+//! This changes neither checkpoint revisions nor durable acknowledgement order.
+//! Queue saturation, stale weak identities and oversized fragments fall back
+//! to the ordinary encoder. Only the exact live Arc allocation authorizes reuse.
+use super::{Cache, bounded_fragment};
+use serde_json::{Value, value::RawValue};
+use std::sync::{Arc, Mutex, OnceLock, mpsc};
+
+static CACHE: OnceLock<Mutex<Cache>> = OnceLock::new();
+static JOBS: OnceLock<mpsc::SyncSender<Arc<Value>>> = OnceLock::new();
+
+fn next_job(receiver: &Mutex<mpsc::Receiver<Arc<Value>>>) -> Option<Arc<Value>> {
+    // Release the receive lock before the caller encodes; both workers can
+    // execute concurrently, including on Rust editions with extended temporaries.
+    receiver.lock().ok()?.recv().ok()
+}
+
+fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("MARKETFORGE_PINE_BACKGROUND_JSON").as_deref() == Ok("1"))
+}
+
+pub(crate) fn enqueue(data: &Arc<Value>) {
+    if !enabled() {
+        return;
+    }
+    let jobs = JOBS.get_or_init(|| {
+        // At most eight queued and two active state references. Encoding stops
+        // at 256 KiB per fragment; the independent retained cache is <=64 MiB.
+        let (sender, receiver) = mpsc::sync_channel::<Arc<Value>>(8);
+        let receiver = Arc::new(Mutex::new(receiver));
+        for index in 0..2 {
+            let receiver = receiver.clone();
+            let _ = std::thread::Builder::new()
+                .name(format!("pine-json-prefetch-{index}"))
+                .spawn(move || {
+                    while let Some(data) = next_job(&receiver) {
+                        #[cfg(feature = "bench-execution-timing")]
+                        let _timer = crate::bench_execution_timing::Timer::start(
+                            &crate::bench_execution_timing::PINE_BACKGROUND_JSON,
+                        );
+                        let Some(json) = bounded_fragment(&data) else {
+                            continue;
+                        };
+                        let mut cache = CACHE.get_or_init(Mutex::default).lock().unwrap();
+                        // A prepared fragment is always provided, so insertion
+                        // never recursively consults this global cache.
+                        let _ = cache.get_prepared(&data, Some(json));
+                    }
+                });
+        }
+        sender
+    });
+    // Best effort only: a full queue must never hold up a trading decision.
+    let _ = jobs.try_send(data.clone());
+}
+
+pub(super) fn get(data: &Arc<Value>) -> Option<Arc<RawValue>> {
+    get_value(data)
+}
+
+#[cfg(feature = "pine-in-process")]
+pub(crate) fn value_len(data: &Value) -> Option<usize> {
+    get_value(data).map(|json| json.get().len())
+}
+
+fn get_value(data: &Value) -> Option<Arc<RawValue>> {
+    if !enabled() {
+        return None;
+    }
+    let cache = CACHE.get()?.lock().ok()?;
+    let entry = cache.entries.get(&(std::ptr::from_ref(data) as usize))?;
+    let source = entry.source.upgrade()?;
+    if !std::ptr::eq(source.as_ref(), data) {
+        return None;
+    }
+    #[cfg(feature = "bench-execution-timing")]
+    let _timer = crate::bench_execution_timing::Timer::start(
+        &crate::bench_execution_timing::PINE_BACKGROUND_HIT,
+    );
+    Some(entry.json.clone())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn fragment_identity_requires_live_immutable_source_and_bounds_are_exact() {
+        let mut source = Arc::new(json!({"checkpoint":{"bars":32},"host":{"opaque":"策略🐱"}}));
+        let original = source.clone();
+        let mut cache = Cache::default();
+        let raw = bounded_fragment(&source).unwrap();
+        assert_eq!(
+            raw.get().as_bytes(),
+            serde_json::to_vec(source.as_ref()).unwrap()
+        );
+        cache.get_prepared(&source, Some(raw)).unwrap();
+        assert!(cache.contains(&original));
+        Arc::make_mut(&mut source)["host"]["opaque"] = json!("changed");
+        assert!(!cache.contains(&source));
+        assert!(cache.contains(&original));
+        let key = Arc::as_ptr(&original) as usize;
+        drop(original);
+        assert!(cache.entries[&key].source.upgrade().is_none());
+        assert!(bounded_fragment(&Arc::new(json!({"padding":"x".repeat(256*1024)}))).is_none());
+    }
+}
