+#[derive(Clone, Copy)]
+pub(super) struct Options {
+    pub workers: usize,
+    pub pine_batch: usize,
+    pub wake_spread_ms: u64,
+}
+
+fn bounded(
+    value: Option<&str>,
+    fallback: usize,
+    maximum: usize,
+    name: &str,
+) -> Result<usize, String> {
+    let result = value.map_or(Ok(fallback), |value| {
+        value
+            .parse::<usize>()
+            .map_err(|error| format!("invalid {name}: {error}"))
+    })?;
+    if !(1..=maximum).contains(&result) {
+        return Err(format!("{name} must be from 1 to {maximum}"));
+    }
+    Ok(result)
+}
+
+pub(super) fn get() -> Result<Options, String> {
+    static OPTIONS: OnceLock<Options> = OnceLock::new();
+    if let Some(options) = OPTIONS.get() {
+        return Ok(*options);
+    }
+    let workers = std::env::var("MARKETFORGE_EXTERNAL_DECISION_WORKERS").ok();
+    let cores = std::thread::available_parallelism().map_or(1, |cores| cores.get());
+    let workers = if workers.as_deref() == Some("auto") {
+        bounded(None, cores, 256, "available_parallelism")?
+    } else {
+        bounded(
+            workers.as_deref(),
+            16,
+            256,
+            "MARKETFORGE_EXTERNAL_DECISION_WORKERS",
+        )?
+    };
+    let batch = std::env::var("MARKETFORGE_PINE_TASK_BATCH").ok();
+    let pine_batch = bounded(batch.as_deref(), 1, 8, "MARKETFORGE_PINE_TASK_BATCH")?;
+    let wake_spread_ms = std::env::var("MARKETFORGE_PINE_WAKE_SPREAD_MS")
+        .ok()
+        .map_or(Ok(0), |value| {
+            value
+                .parse::<u64>()
+                .map_err(|error| format!("invalid MARKETFORGE_PINE_WAKE_SPREAD_MS: {error}"))
+        })?;
+    if wake_spread_ms > 250 {
+        return Err("MARKETFORGE_PINE_WAKE_SPREAD_MS must be from 0 to 250".into());
+    }
+    Ok(*OPTIONS.get_or_init(|| Options {
+        workers,
+        pine_batch,
+        wake_spread_ms,
+    }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn admission_controls_are_bounded_and_invalid_values_are_rejected() {
+        assert_eq!(bounded(None, 16, 256, "workers").unwrap(), 16);
+        assert_eq!(bounded(Some("32"), 16, 256, "workers").unwrap(), 32);
+        assert_eq!(bounded(Some("8"), 1, 8, "batch").unwrap(), 8);
+        for value in ["0", "257", "bad", "-1"] {
+            assert!(bounded(Some(value), 16, 256, "workers").is_err());
+        }
+        assert!(bounded(Some("9"), 1, 8, "batch").is_err());
+    }
+}
