+//! Complete borrowed host calls over a frozen, prepared 1000-bot turn fixture.
+//! This includes the VM and guards, but excludes gateway/journal/queue work.
+use super::{Checks, enter_checks};
+use super::super::*;
+use exchange_core::{Candle, candle_history_hex, candle_history_seed};
+
+fn market_data(count: usize) -> exchange_core::observation::BotMarketData {
+    let candles: Vec<_> = (0..count).map(|i| {
+        let close = 100 + ((i * 73 + i * i * 13) % 101) as i64;
+        Candle { schema_version: 1, open_time_ms: i as u64*1000,
+            close_time_ms: (i as u64+1)*1000, open_tick: close, high_tick: close+3,
+            low_tick: close-4, close_tick: close, volume: 1, quote_volume: i128::from(close),
+            trades: 1, taker_buy_base: Some(0), taker_buy_quote: Some(0), is_final: true }
+    }).collect();
+    serde_json::from_value(json!({"interval_ms":1000,"candles":candles,
+        "own_fills":[],"fill_details":[],"truncated":false,"private_history_complete":true,
+        "history_proof":{"version":1,"prefix_bars":0,"prefix_sha256":candle_history_hex(&candle_history_seed(1000))}})).unwrap()
+}
+
+fn call(host: &Host, config: &BotConfig, state: &Value, view: &ParticipantObservation) -> BotDecisionResponse {
+    match host.route_borrowed(config, state, view, 5000, || {}) {
+        DirectAttempt::Executed(result) => result.unwrap(),
+        DirectAttempt::NotQualified(reason) => panic!("fixed turn escaped direct route: {reason}"),
+    }
+}
+
+#[cfg(feature = "bench-execution-timing")]
+fn metric(name: &str) -> u64 {
+    let mut body = String::new();
+    crate::bench_execution_timing::append_metrics(&mut body);
+    let prefix = format!("marketforge_bench_{name}_nanos_total ");
+    body.lines().find_map(|line| line.strip_prefix(&prefix)).unwrap().parse().unwrap()
+}
+
+#[test]
+#[ignore = "explicit complete 1000-host-turn ABBA experiment; no simultaneous load"]
+fn complete_prepared_1000_borrowed_turns_have_exact_responses() {
+    let directory = Path::new(env!("CARGO_MANIFEST_DIR")).parent().unwrap().join("bot-plugins/pine-strategy");
+    let manifest: crate::bot_plugins::ProcessBotManifest = serde_json::from_str(
+        include_str!("../../../bot-plugins/pine-strategy/bot.json")).unwrap();
+    let fixture: Value = serde_json::from_str(include_str!("../../../scripts/fixtures/f6_batch_spec.json")).unwrap();
+    let scenario: exchange_core::ScenarioConfig = serde_json::from_value(fixture["scenario"].clone()).unwrap();
+    let room = scenario.room_id.clone();
+    let mut rooms = exchange_core::RoomManager::new();
+    rooms.create_room(scenario).unwrap();
+    let mut prior = rooms.participant_observation(&room, "V-BTC-SPOT", 20).unwrap();
+    prior.market_time_ms = 64_000;
+    prior.step = 64;
+    prior.bot_market_data = Some(market_data(64));
+    let mut next = prior.clone();
+    next.market_time_ms = 65_000;
+    next.step = 65;
+    next.bot_market_data = Some(market_data(65));
+    let configs: Vec<BotConfig> = (0..1000).map(|index| {
+        let script = ["ma.pine", "rsi.pine", "limit.pine"][index % 3];
+        serde_json::from_value(json!({"plugin_id":"pine.strategy","plugin_version":"2.0.0","state_version":1,
+            "seed":index+7,"participant":{"participant_id":format!("fixed-{index}"),"room_id":room,
+                "account_id":20,"instrument_id":"V-BTC-SPOT","kind":"RuleAgent"},
+            "config":manifest.bot.validate_config(&json!({"script":script,
+                "bar_interval_ms":1000,"history_limit":512})).unwrap()})).unwrap()
+    }).collect();
+    let make_host = |cached: bool| {
+        let mut host = Host::load(&directory).unwrap().with_checkpoint_mode(true);
+        host.wave_source_checks = true;
+        host.identity_cache_enabled = cached;
+        host.seal_cache_enabled = cached;
+        host.reuse_input_length = cached;
+        host
+    };
+    let reference = make_host(false);
+    let committed: Vec<Value> = {
+        let _wave = enter_checks(Arc::<Checks>::default());
+        configs.iter().map(|config| call(&reference, config, &Value::Null, &prior).state).collect()
+    };
+    let expected: Vec<Vec<u8>> = {
+        let _wave = enter_checks(Arc::<Checks>::default());
+        configs.iter().zip(&committed).map(|(config, state)| serde_json::to_vec(&call(&reference, config, state, &next)).unwrap()).collect()
+    };
+    let prepared = json!({"configs":configs,"committed":committed,"prior":prior,"next":next});
+    let fixture_bytes = serde_json::to_vec(&prepared).unwrap();
+    let mut rows = Vec::new();
+    for (parallel, round) in [(false, 0), (false, 1), (true, 0)] {
+        for cached in [false, true, true, false] {
+            let host = make_host(cached);
+            let preparation_started = Instant::now();
+            {
+                let _wave = enter_checks(Arc::<Checks>::default());
+                for (config, state) in configs.iter().zip(&committed) {
+                    assert_eq!(call(&host, config, &Value::Null, &prior).state, *state);
+                }
+            }
+            let preparation_ms = preparation_started.elapsed().as_secs_f64()*1000.0;
+            #[cfg(feature = "bench-execution-timing")]
+            let vm_before = metric("bot_pine_vm_execute");
+            let started = Instant::now();
+            let responses: Vec<_> = if parallel {
+                let checks = Arc::<Checks>::default();
+                std::thread::scope(|scope| {
+                    let tasks: Vec<_> = configs.chunks(63).zip(committed.chunks(63)).map(|(configs, states)| {
+                        let checks = checks.clone();
+                        let host = &host;
+                        let view = &next;
+                        scope.spawn(move || {
+                            let _wave = enter_checks(checks);
+                            configs.iter().zip(states).map(|(config, state)| call(host, config, state, view)).collect::<Vec<_>>()
+                        })
+                    }).collect();
+                    tasks.into_iter().flat_map(|task| task.join().unwrap()).collect()
+                })
+            } else {
+                let _wave = enter_checks(Arc::<Checks>::default());
+                configs.iter().zip(&committed).map(|(config, state)| call(&host, config, state, &next)).collect()
+            };
+            let total_ms = started.elapsed().as_secs_f64()*1000.0;
+            #[cfg(feature = "bench-execution-timing")]
+            let vm_ms = (metric("bot_pine_vm_execute")-vm_before) as f64/1_000_000.0;
+            #[cfg(not(feature = "bench-execution-timing"))]
+            let vm_ms: Option<f64> = None;
+            for (response, expected) in responses.iter().zip(&expected) {
+                assert_eq!(&serde_json::to_vec(response).unwrap(), expected);
+            }
+            rows.push(json!({"round":round,"parallel_workers":if parallel {16} else {1},"cached":cached,"turns":responses.len(),"total_ms":total_ms,
+                "vm_ms":vm_ms,"preparation_ms_excluded":preparation_ms,"exact_full_responses":true}));
+        }
+    }
+    if let Ok(path) = std::env::var("MARKETFORGE_PINE_TURN_FIXTURE_OUTPUT") {
+        std::fs::write(path, &fixture_bytes).unwrap();
+    }
+    let result = json!({"fixture_sha256":format!("{:x}",Sha256::digest(&fixture_bytes)),"fixture_bytes":fixture_bytes.len(),
+        "cases":rows,"scope":"Two sequential ABBA rounds and one 16-worker ABBA, prepared schema3 states and complete borrowed host calls including source admission, exact guards, seals, broker and VM. Both share source checks per wave. Three qualified scripts, synthetic authoritative-history inputs, 1000 distinct identities sharing one fixture account. Excludes preparing hosts/states, trigger, queue, gateway, journal and asynchronous load. VM elapsed scopes overlap in parallel mode and must not be subtracted from wall time. Not a replay of missing historical v14 artifacts."});
+    if let Ok(path) = std::env::var("MARKETFORGE_PINE_TURN_BENCH_OUTPUT") {
+        std::fs::write(path, serde_json::to_vec_pretty(&result).unwrap()).unwrap();
+    }
+    eprintln!("{result}");
+}
diff --git a/exchange-server/src/pine_inprocess/host_state_benchmark.rs b/exchange-server/src/pine_inprocess/host_state_benchmark.rs
new file mode 100644
index 0000000..2cce2d1
--- /dev/null
+++ b/exchange-server/src/pine_inprocess/host_state_benchmark.rs
@@ -0,0 +1,140 @@
+//! Isolated typed-state boundary prototype, not an alternate trading runtime.
+//! Include clone and durable Value materialization; scalar-only microbenchmarks
+//! would hide the dominant cost of adapting back to the current host contract.
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::{collections::BTreeMap, sync::Arc, time::Instant};
+
+#[derive(Clone, Deserialize, Serialize)]
+struct TypedState {
+    broker_schema: u64,
+    identity: String,
+    evaluated_bars: u64,
+    last_bar_time: u64,
+    execution_seal: String,
+    vm_checkpoint: Arc<Value>,
+    vm_tail: Arc<Vec<Value>>,
+    vm_tail_intents: Arc<Vec<Value>>,
+    candle_audits: Arc<BTreeMap<String, Value>>,
+    #[serde(flatten)]
+    other: BTreeMap<String, Arc<Value>>,
+}
+
+// Direct typed encoding removes Value materialization, but requires a host
+// accepting this representation. Keep canonical root key order for byte parity.
+#[derive(Serialize)]
+#[serde(untagged)]
+enum Field<'a> {
+    Number(u64),
+    Text(&'a str),
+    Value(&'a Value),
+    Array(&'a [Value]),
+    Object(&'a BTreeMap<String, Value>),
+}
+
+struct Canonical<'a>(&'a TypedState);
+impl Serialize for Canonical<'_> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let state = self.0;
+        let mut fields: BTreeMap<&str, Field<'_>> = state
+            .other
+            .iter()
+            .map(|(name, value)| (name.as_str(), Field::Value(value)))
+            .collect();
+        fields.insert("broker_schema", Field::Number(state.broker_schema));
+        fields.insert("identity", Field::Text(&state.identity));
+        fields.insert("evaluated_bars", Field::Number(state.evaluated_bars));
+        fields.insert("last_bar_time", Field::Number(state.last_bar_time));
+        fields.insert("execution_seal", Field::Text(&state.execution_seal));
+        fields.insert("vm_checkpoint", Field::Value(&state.vm_checkpoint));
+        fields.insert("vm_tail", Field::Array(&state.vm_tail));
+        fields.insert("vm_tail_intents", Field::Array(&state.vm_tail_intents));
+        fields.insert("candle_audits", Field::Object(&state.candle_audits));
+        fields.serialize(serializer)
+    }
+}
+
+#[test]
+#[ignore = "explicit fixed-work experiment requires a saved real scheduler fixture"]
+fn typed_state_clone_and_durable_boundary_abba() {
+    let fixture_path =
+        std::env::var("MARKETFORGE_PINE_STATE_FIXTURE").expect("saved scheduler JSON path");
+    let input = std::fs::read(&fixture_path).unwrap();
+    let scheduler: Value = serde_json::from_slice(&input).unwrap();
+    let states: Vec<Value> = scheduler["agents"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter(|agent| agent["template"]["Plugin"]["plugin_id"] == "pine.strategy")
+        .map(|agent| agent["kind_state"]["Plugin"]["data"].clone())
+        .collect();
+    assert_eq!(states.len(), 1000, "freeze a complete 1000-bot fixture");
+    let typed: Vec<TypedState> = states
+        .iter()
+        .map(|state| TypedState::deserialize(state).unwrap())
+        .collect();
+    for (state, typed) in states.iter().zip(&typed) {
+        let value = serde_json::to_value(typed).unwrap();
+        assert_eq!(&value, state);
+        assert_eq!(
+            serde_json::to_vec(&value).unwrap(),
+            serde_json::to_vec(state).unwrap()
+        );
+        assert_eq!(
+            serde_json::to_vec(&Canonical(typed)).unwrap(),
+            serde_json::to_vec(state).unwrap()
+        );
+    }
+    let mut rows = Vec::new();
+    for round in 0..3 {
+        for mode in [
+            "value",
+            "typed",
+            "typed",
+            "value",
+            "value",
+            "typed_direct",
+            "typed_direct",
+            "value",
+        ] {
+            let start = Instant::now();
+            let mut outputs = Vec::with_capacity(states.len());
+            if mode == "value" {
+                for state in &states {
+                    let mut working = state.clone();
+                    let next = working["evaluated_bars"].as_u64().unwrap() + 1;
+                    working["evaluated_bars"] = serde_json::json!(next);
+                    outputs.push(serde_json::to_vec(&working).unwrap());
+                }
+            } else {
+                for state in &typed {
+                    let mut working = state.clone();
+                    working.evaluated_bars += 1;
+                    if mode == "typed_direct" {
+                        outputs.push(serde_json::to_vec(&Canonical(&working)).unwrap());
+                    } else {
+                        let value = serde_json::to_value(&working).unwrap();
+                        outputs.push(serde_json::to_vec(&value).unwrap());
+                    }
+                }
+            }
+            let elapsed_ms = start.elapsed().as_secs_f64() * 1000.0;
+            for ((state, typed), bytes) in states.iter().zip(&typed).zip(&outputs) {
+                let mut expected = state.clone();
+                expected["evaluated_bars"] = serde_json::json!(typed.evaluated_bars + 1);
+                assert_eq!(bytes, &serde_json::to_vec(&expected).unwrap());
+            }
+            let row = serde_json::json!({"round":round,"mode":mode,"states":states.len(),
+                "elapsed_ms":elapsed_ms,"output_bytes":outputs.iter().map(Vec::len).sum::<usize>(),"byte_equal":true});
+            eprintln!("{row}");
+            rows.push(row);
+            std::hint::black_box(outputs);
+        }
+    }
+    if let Ok(output_path) = std::env::var("MARKETFORGE_PINE_STATE_BENCH_OUTPUT") {
+        use sha2::{Digest, Sha256};
+        let result = serde_json::json!({"fixture":fixture_path,"fixture_sha256":format!("{:x}",Sha256::digest(&input)),
+            "cases":rows,"scope":"Three serial ABBA rounds for typed Value-boundary and direct canonical encoding separately; predecoded typed records; clone + scalar edit + exact durable encode. Direct mode requires a different internal host representation. Excludes VM, gateway, state admission and queueing. Not a complete typed broker architecture."});
+        std::fs::write(output_path, serde_json::to_vec_pretty(&result).unwrap()).unwrap();
+    }
+}
