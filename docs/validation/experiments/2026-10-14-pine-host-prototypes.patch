+//! Compare the real borrowed-route request guard with its original serializer.
+use super::*;
+
+#[test]
+fn reused_input_counts_exact_four_mib_boundaries_and_unicode_metadata() {
+    let directory = Path::new(env!("CARGO_MANIFEST_DIR")).parent().unwrap().join("bot-plugins/pine-strategy");
+    let original = Host::load(&directory).unwrap().with_checkpoint_mode(false);
+    let mut candidate = Host::load(&directory).unwrap().with_checkpoint_mode(false);
+    candidate.reuse_input_length = true;
+    let fixture: Value = serde_json::from_str(include_str!("../../../scripts/fixtures/f6_batch_spec.json")).unwrap();
+    let mut rooms = exchange_core::RoomManager::new();
+    let scenario: exchange_core::ScenarioConfig = serde_json::from_value(fixture["scenario"].clone()).unwrap();
+    let room = scenario.room_id.clone();
+    rooms.create_room(scenario).unwrap();
+    let view = rooms.participant_observation(&room, "V-BTC-SPOT", 20).unwrap();
+    let config: BotConfig = serde_json::from_value(json!({"plugin_id":"pine.strategy","plugin_version":"2.0.0",
+        "participant":{"participant_id":"大小🐱","room_id":room,"account_id":20,"instrument_id":"V-BTC-SPOT","kind":"RuleAgent"},
+        "config":{"execution_mode":"broker","script":"ma.pine","hedge_instrument_id":"","inputs":{},
+            "bar_interval_ms":1000,"history_limit":512,"max_qty":2,"inventory_cap":10,
+            "slippage_ticks":2,"fee_buffer_ppm":1000,"initial_avg_price_tick":0,"position_side":"Both",
+            "related_instruments":[],"additional_intervals_ms":[]}})).unwrap();
+    let make = |state: Value| BotDecisionRequest {
+        protocol_version: exchange_core::BOT_PROTOCOL_VERSION.into(),
+        plugin_id: config.plugin_id.clone(), plugin_version: config.plugin_version.clone(), state_version: config.state_version,
+        participant: config.participant.clone(), seed: config.seed, config: config.config.clone(), state, observation: view.clone(),
+    };
+    let empty = make(json!({"控制padding":"","numeric":[-0.0,1e-7,u64::MAX],"extra":"策略🐱"}));
+    let fixed = serde_json::to_vec(&empty).unwrap().len();
+    for target in [4_194_303,4_194_304,4_194_305] {
+        let mut request = empty.clone();
+        request.state["控制padding"] = json!("x".repeat(target-fixed));
+        assert_eq!(serde_json::to_vec(&request).unwrap().len(), target);
+        let old = original.decide_borrowed(&config, &request.state, &view, 5000).unwrap_err();
+        let new = candidate.decide_borrowed(&config, &request.state, &view, 5000).unwrap_err();
+        assert_eq!(old.0, new.0);
+        assert_eq!(new.0 == "bot request exceeds size limit", target > 4_194_304);
+    }
+}
diff --git a/exchange-server/src/pine_inprocess/seal_cache.rs b/exchange-server/src/pine_inprocess/seal_cache.rs
new file mode 100644
index 0000000..63adae7
--- /dev/null
+++ b/exchange-server/src/pine_inprocess/seal_cache.rs
@@ -0,0 +1,122 @@
+//! Complete private execution-envelope proof. Only a locally generated seal,
+//! after successful bounds/deadline checks, can populate this cache. A hit
+//! compares every field covered by the public seal plus the seal itself.
+use super::{io, stamp_cache::bytes_match};
+use exchange_core::BotError;
+use serde::Serialize;
+use serde_json::Value;
+use std::{
+    collections::{BTreeMap, VecDeque},
+    sync::{Arc, Mutex},
+};
+
+#[derive(Serialize)]
+struct Vm<'a> {
+    checkpoint: &'a Value,
+    intents: &'a Value,
+    tail: &'a Value,
+}
+
+#[derive(Serialize)]
+struct Envelope<'a> {
+    audits: &'a Value,
+    evaluated: &'a Value,
+    last_time: &'a Value,
+    seal: &'a Value,
+    vm: Vm<'a>,
+}
+
+fn envelope(state: &Value) -> Envelope<'_> {
+    Envelope {
+        audits: &state["candle_audits"],
+        evaluated: &state["evaluated_bars"],
+        last_time: &state["last_bar_time"],
+        seal: &state["execution_seal"],
+        vm: Vm {
+            checkpoint: &state["vm_checkpoint"],
+            intents: &state["vm_tail_intents"],
+            tail: &state["vm_tail"],
+        },
+    }
+}
+
+type Entry = Arc<Mutex<Vec<u8>>>;
+#[derive(Default)]
+struct Entries {
+    values: BTreeMap<String, Entry>,
+    order: VecDeque<String>,
+}
+
+#[derive(Default)]
+pub(super) struct Cache(Mutex<Entries>);
+
+impl Cache {
+    pub(super) fn matches(&self, identity: &str, state: &Value) -> Result<bool, BotError> {
+        let entry = self.0.lock().map_err(io)?.values.get(identity).cloned();
+        let Some(entry) = entry else { return Ok(false) };
+        let bytes = entry.lock().map_err(io)?;
+        Ok(bytes_match(&bytes, &envelope(state)))
+    }
+
+    pub(super) fn remember(&self, identity: &str, state: &Value) -> Result<(), BotError> {
+        let entry = {
+            let mut entries = self.0.lock().map_err(io)?;
+            if let Some(entry) = entries.values.get(identity) {
+                entry.clone()
+            } else {
+                while entries.values.len() >= 2048 {
+                    let oldest = entries.order.pop_front().unwrap();
+                    entries.values.remove(&oldest);
+                }
+                let entry = Arc::new(Mutex::new(Vec::new()));
+                entries.values.insert(identity.to_owned(), entry.clone());
+                entries.order.push_back(identity.to_owned());
+                entry
+            }
+        };
+        let mut bytes = entry.lock().map_err(io)?;
+        bytes.clear();
+        serde_json::to_writer(&mut *bytes, &envelope(state)).map_err(io)
+    }
+
+    pub(super) fn clear(&self) {
+        *self.0.lock().unwrap() = Entries::default();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn every_sealed_field_and_seal_must_match_but_host_metadata_is_external() {
+        let cache = Cache::default();
+        let state = json!({"candle_audits":{"p":{"count":32}},"evaluated_bars":32,"last_bar_time":32000,
+            "execution_seal":"verified","vm_checkpoint":{"bars":32},"vm_tail":[],"vm_tail_intents":[]});
