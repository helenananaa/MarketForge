diff --git a/exchange-server/src/journal_worker/checkpoint_budget.rs b/exchange-server/src/journal_worker/checkpoint_budget.rs
new file mode 100644
index 0000000..8725e6e
--- /dev/null
+++ b/exchange-server/src/journal_worker/checkpoint_budget.rs
@@ -0,0 +1,218 @@
+//! Alternative checkpoint triggers, tied to successful ordered journal writes.
+//! The <=499 delta recovery bound is unchanged. Missing history, restart or a
+//! predecessor gap forces a full state; metadata never authorizes durable data.
+use crate::journal::{JournalError, PendingJournalMutation, RoomMutation};
+use std::{
+    collections::BTreeMap,
+    sync::Mutex,
+    time::{Duration, Instant},
+};
+
+#[derive(Clone, Copy)]
+struct Options {
+    bytes: usize,
+    time: Duration,
+}
+
+fn options() -> Result<Option<Options>, String> {
+    let number = |name: &str| {
+        std::env::var(name).ok().map_or(Ok(0), |value| {
+            value
+                .parse::<u64>()
+                .map_err(|error| format!("invalid {name}: {error}"))
+        })
+    };
+    let bytes = number("MARKETFORGE_SCHEDULER_CHECKPOINT_BYTES")?;
+    let time_ms = number("MARKETFORGE_SCHEDULER_CHECKPOINT_MS")?;
+    if bytes > 256 * 1024 * 1024 || time_ms > 3_600_000 {
+        return Err("checkpoint experiment limit exceeds its bound".into());
+    }
+    Ok((bytes != 0 || time_ms != 0).then_some(Options {
+        bytes: bytes as usize,
+        time: Duration::from_millis(time_ms),
+    }))
+}
+
+struct Entry {
+    full: u64,
+    current: u64,
+    bytes: usize,
+    at: Instant,
+}
+
+pub(super) struct Budget {
+    options: Result<Option<Options>, String>,
+    entries: Mutex<BTreeMap<String, Entry>>,
+}
+
+impl Default for Budget {
+    fn default() -> Self {
+        Self {
+            options: options(),
+            entries: Mutex::default(),
+        }
+    }
+}
+
+impl Budget {
+    pub(super) fn due(&self, room: &str, revision: u64) -> Result<bool, JournalError> {
+        self.due_at(room, revision, Instant::now())
+    }
+
+    fn due_at(&self, room: &str, revision: u64, now: Instant) -> Result<bool, JournalError> {
+        let Some(options) = self
+            .options
+            .as_ref()
+            .map_err(|error| JournalError::Recovery(error.clone()))?
+        else {
+            return Ok(crate::scheduler_checkpoint_due(revision));
+        };
+        let Ok(entries) = self.entries.lock() else {
+            return Ok(crate::scheduler_checkpoint_due(revision));
+        };
+        let Some(entry) = entries.get(room) else {
+            return Ok(true);
+        };
+        if entry.current.checked_add(1) != Some(revision) || revision <= entry.full {
+            return Ok(true);
+        }
+        Ok(revision - entry.full > crate::MAX_SCHEDULER_DELTA_TAIL
+            || (options.bytes != 0 && entry.bytes >= options.bytes)
+            || (!options.time.is_zero() && now.saturating_duration_since(entry.at) >= options.time))
+    }
+
+    pub(super) fn observe(&self, mutation: &PendingJournalMutation) {
+        let Ok(Some(options)) = self.options.as_ref() else {
+            return;
+        };
+        // A successful idempotent control replay may append no new record.
+        // It must never create an apparent recovery anchor. A newly committed
+        // manual revision will be detected as a gap and force the next full state.
+        if mutation.control_idempotency.is_some() {
+            return;
+        }
+        let (revision, base, bytes) = match &mutation.mutation {
+            RoomMutation::SchedulerProgress { state, .. } => (state.revision, None, 0),
+            RoomMutation::SchedulerDelta { delta, .. } => {
+                let bytes = if options.bytes == 0 {
+                    Some(0)
+                } else {
+                    encoded_len(&mutation.mutation)
+                };
+                let Some(bytes) = bytes else {
+                    if let Ok(mut entries) = self.entries.lock() {
+                        entries.remove(&mutation.room_id);
+                    }
+                    return;
+                };
+                (delta.state.revision, Some(delta.base_revision), bytes)
+            }
+            _ => return,
+        };
+        self.record(&mutation.room_id, revision, base, bytes, Instant::now());
+    }
+
+    fn record(&self, room: &str, revision: u64, base: Option<u64>, bytes: usize, now: Instant) {
+        let Ok(mut entries) = self.entries.lock() else {
+            return;
+        };
+        match base {
+            None => {
+                entries.insert(
+                    room.to_owned(),
+                    Entry {
+                        full: revision,
+                        current: revision,
+                        bytes: 0,
+                        at: now,
+                    },
+                );
+            }
+            Some(base) => {
+                if let Some(entry) = entries.get_mut(room)
+                    && entry.current == base
+                    && base.checked_add(1) == Some(revision)
+                {
+                    entry.current = revision;
+                    entry.bytes = entry.bytes.saturating_add(bytes);
+                } else {
+                    entries.remove(room);
+                }
+            }
+        }
+    }
+}
+
+fn encoded_len(value: &impl serde::Serialize) -> Option<usize> {
+    struct Counter(usize);
+    impl std::io::Write for Counter {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0 = self
+                .0
+                .checked_add(bytes.len())
+                .ok_or_else(|| std::io::Error::other("checkpoint byte counter overflow"))?;
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut counter = Counter(0);
+    serde_json::to_writer(&mut counter, value).ok()?;
+    Some(counter.0)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn budget(bytes: usize, time: u64) -> Budget {
+        Budget {
+            options: Ok(Some(Options {
+                bytes,
+                time: Duration::from_millis(time),
+            })),
+            entries: Mutex::default(),
+        }
+    }
+
+    #[test]
+    fn alternative_policy_counts_from_actual_full_and_never_extends_the_recovery_tail() {
+        let budget = budget(usize::MAX, 0);
+        let now = Instant::now();
+        assert!(budget.due_at("r", 451, now).unwrap());
+        budget.record("r", 450, None, 0, now);
+        for revision in 451..950 {
+            assert!(!budget.due_at("r", revision, now).unwrap());
+            budget.record("r", revision, Some(revision - 1), 7, now);
+        }
+        assert!(budget.due_at("r", 950, now).unwrap());
+        assert!(budget.due_at("other", 950, now).unwrap());
+        budget.record("r", 951, Some(949), 7, now);
+        assert!(
+            budget.due_at("r", 952, now).unwrap(),
+            "gap requires full recovery anchor"
+        );
+    }
+
+    #[test]
+    fn byte_and_time_thresholds_are_independent_and_full_resets_them() {
+        let now = Instant::now();
+        let budget = budget(100, 1000);
+        budget.record("r", 0, None, 0, now);
+        budget.record("r", 1, Some(0), 100, now);
+        assert!(budget.due_at("r", 2, now).unwrap());
+        budget.record("r", 2, None, 0, now);
+        assert!(!budget.due_at("r", 3, now).unwrap());
+        assert!(budget.due_at("r", 3, now + Duration::from_secs(1)).unwrap());
+        assert!(
+            budget.due_at("r", 5, now).unwrap(),
+            "unknown predecessor cannot postpone full validation"
+        );
+        let value = serde_json::json!({"unicode":"策略🐱","float":-0.0,"x":[1,2,null]});
+        assert_eq!(
+            encoded_len(&value).unwrap(),
+            serde_json::to_vec(&value).unwrap().len()
+        );
+    }
+}
