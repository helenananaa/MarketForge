@@ -0,0 +1,71 @@
+//! Full saved-state cache work, including writing the next trusted proof.
+use super::*;
+
+#[test]
+#[ignore = "explicit fixed-work 1000-Pine fixture cache experiment"]
+fn saved_state_identity_and_complete_seal_cache_abba() {
+    let fixture = std::env::var("MARKETFORGE_PINE_STATE_FIXTURE").unwrap();
+    let bytes = std::fs::read(&fixture).unwrap();
+    let scheduler: Value = serde_json::from_slice(&bytes).unwrap();
+    // Persisted templates contain user input. Actual ProcessBot construction
+    // validates it and inserts manifest defaults before computing identity.
+    let manifest: crate::bot_plugins::ProcessBotManifest = serde_json::from_str(
+        include_str!("../../../bot-plugins/pine-strategy/bot.json")).unwrap();
+    let states: Vec<_> = scheduler["agents"].as_array().unwrap().iter()
+        .filter(|agent| agent["template"]["Plugin"]["plugin_id"] == "pine.strategy")
+        .map(|agent| {
+            let mut config = agent["template"]["Plugin"].clone();
+            config["config"] = manifest.bot.validate_config(&config["config"]).unwrap();
+            (config, &agent["kind_state"]["Plugin"]["data"])
+        })
+        .collect();
+    assert_eq!(states.len(), 1000);
+    let directory = Path::new(env!("CARGO_MANIFEST_DIR")).parent().unwrap().join("bot-plugins/pine-strategy");
+    let host = Host::load(&directory).unwrap();
+    let identities = identity_cache::Cache::default();
+    let seals = seal_cache::Cache::default();
+    for (config, state) in &states {
+        let source = &host.programs[config["config"]["script"].as_str().unwrap()].source;
+        assert_eq!(identities.identity(source, &config["config"], &config["participant"]).unwrap(), state["identity"]);
+        assert_eq!(execution_seal(state).unwrap(), state["execution_seal"]);
+        seals.remember(state["identity"].as_str().unwrap(), state).unwrap();
+    }
+    let mut rows = Vec::new();
+    for round in 0..3 {
+        for mode in ["original", "cached", "cached", "original"] {
+            let started = Instant::now();
+            let mut results = Vec::with_capacity(states.len());
+            for (config, state) in &states {
+                let source = &host.programs[config["config"]["script"].as_str().unwrap()].source;
+                let identity = if mode == "cached" {
+                    identities.identity(source, &config["config"], &config["participant"]).unwrap()
+                } else {
+                    digest(&json!({"source":source,"config":config["config"],"participant":config["participant"]})).unwrap()
+                };
+                // Production produces an outgoing seal in both modes. The
+                // candidate additionally stores its full authenticated proof.
+                let outgoing = execution_seal(state).unwrap();
+                if mode == "cached" {
+                    seals.remember(&identity, state).unwrap();
+                    assert!(seals.matches(&identity, state).unwrap());
+                } else {
+                    assert_eq!(execution_seal(state).unwrap(), outgoing);
+                }
+                results.push((identity, outgoing));
+            }
+            let elapsed_ms = started.elapsed().as_secs_f64()*1000.0;
+            for ((_, state), (identity, seal)) in states.iter().zip(&results) {
+                assert_eq!(identity, state["identity"].as_str().unwrap());
+                assert_eq!(seal, state["execution_seal"].as_str().unwrap());
+            }
+            rows.push(json!({"round":round,"mode":mode,"states":states.len(),"elapsed_ms":elapsed_ms,"exact":true}));
+            std::hint::black_box(results);
+        }
+    }
+    let result = json!({"fixture":fixture,"fixture_sha256":format!("{:x}",Sha256::digest(&bytes)),"cases":rows,
+        "scope":"Three ABBA rounds over complete saved states: identity plus incoming/outgoing seal work, including proof write and match. Excludes VM, observation construction, cold restore, gateway and asynchronous load; not a complete single-turn replay."});
+    if let Ok(path) = std::env::var("MARKETFORGE_PINE_CACHE_BENCH_OUTPUT") {
+        std::fs::write(path, serde_json::to_vec_pretty(&result).unwrap()).unwrap();
+    }
+    eprintln!("{result}");
+}
