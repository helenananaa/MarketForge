{
  "bot": {
    "id": "pine.strategy",
    "name": "Pine 策略交易者",
    "version": "2.0.0",
    "protocol_version": "bot.v1",
    "state_version": 1,
    "runtime": "process",
    "parameters": {
      "script": {"type": "string", "default": "ma.pine"},
      "execution_mode": {"type": "string", "default": "broker", "choices": ["broker", "legacy"]},
      "quantize_strategy_orders": {"type": "boolean", "default": false},
      "related_instruments": {"type": "array", "default": []},
      "additional_intervals_ms": {"type": "array", "default": []},
      "position_side": {"type": "string", "default": "Both", "choices": ["Both", "Long", "Short"]},
      "initial_avg_price_tick": {"type": "integer", "default": 0, "minimum": 0},
      "hedge_instrument_id": {"type": "string", "default": ""},
      "hedge_timeout_ms": {"type": "integer", "default": 5000, "minimum": 1000, "maximum": 600000},
      "inputs": {"type": "object", "default": {}},
      "bar_interval_ms": {"type": "integer", "default": 10000, "minimum": 1000, "maximum": 86400000, "choices": [1000, 5000, 10000, 15000, 30000, 45000, 60000, 120000, 180000, 300000, 600000, 900000, 1800000, 3600000, 14400000, 86400000]},
      "history_limit": {"type": "integer", "default": 512, "minimum": 16, "maximum": 2048},
      "max_qty": {"type": "integer", "default": 2, "minimum": 1, "maximum": 1000000},
      "inventory_cap": {"type": "integer", "default": 10, "minimum": 1, "maximum": 1000000},
      "slippage_ticks": {"type": "integer", "default": 2, "minimum": 0, "maximum": 10000},
      "fee_buffer_ppm": {"type": "integer", "default": 1000, "minimum": 0, "maximum": 1000000}
    }
  },
  "command": ["python3", "bot.py"],
  "worker_pool": {"workers": 4, "instance_affinity": true, "delta_requests": true, "resident_state": true, "max_calls": 500000, "command": ["python3", "bot.py", "--worker"]},
  "decision_trigger": {"kind": "events", "closed_bars": true, "account": true},
  "host_event_prefilter": true,
  "timeout_ms": 5000,
  "market_data": {"interval_parameter": "bar_interval_ms", "max_bars": 2049},
  "related_instruments_parameter": "related_instruments",
  "additional_intervals_parameter": "additional_intervals_ms",
  "account_events": true,
  "compatible_versions": ["1.0.0"]
}
