//@version=6
// MarketForge configurable formula adaptation; original authors full scripts remain separate.
strategy("MF Williams", pyramiding=0)
length = input.int(14, title="length")
low_gate = input.float(-80.0, title="low")
high_gate = input.float(-20.0, title="high")
order_qty = input.int(2, title="qty", minval=1)
allow_short = input.bool(false, title="allow_short")
w = ta.wpr(length)
long_entry = w < low_gate
long_exit = w > high_gate
short_entry = w > high_gate
short_exit = w < low_gate
if strategy.position_size == 0
    if long_entry
        strategy.entry("L", strategy.long, qty=order_qty)
    else if allow_short and short_entry
        strategy.entry("S", strategy.short, qty=order_qty)
else if strategy.position_size > 0 and long_exit
    strategy.close("L")
else if strategy.position_size < 0 and short_exit
    strategy.close("S")
plot(long_entry ? 1 : 0, "long_entry")
plot(long_exit ? 1 : 0, "long_exit")
plot(short_entry ? 1 : 0, "short_entry")
plot(short_exit ? 1 : 0, "short_exit")
