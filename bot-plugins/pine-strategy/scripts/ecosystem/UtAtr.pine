//@version=6
// MarketForge configurable formula adaptation; original authors full scripts remain separate.
strategy("MF UtAtr", pyramiding=0)
length = input.int(10, title="length")
factor = input.float(1.0, title="factor")
order_qty = input.int(2, title="qty", minval=1)
allow_short = input.bool(false, title="allow_short")
loss = factor * ta.atr(length)
var float trail = 0.0
prev = nz(trail[1], 0.0)
trail := close > prev and close[1] > prev ? math.max(prev, close - loss) : close < prev and close[1] < prev ? math.min(prev, close + loss) : close > prev ? close - loss : close + loss
long_entry = ta.crossover(close, trail)
long_exit = ta.crossunder(close, trail)
short_entry = ta.crossunder(close, trail)
short_exit = ta.crossover(close, trail)
if strategy.position_size == 0
    if long_entry
        strategy.entry("L", strategy.long, qty=order_qty)
    else if allow_short and short_entry
        strategy.entry("S", strategy.short, qty=order_qty)
else if strategy.position_size > 0 and long_exit
    strategy.close("L")
else if strategy.position_size < 0 and short_exit
    strategy.close("S")
plot(long_entry ? 1 : 0, "long_entry")
plot(long_exit ? 1 : 0, "long_exit")
plot(short_entry ? 1 : 0, "short_entry")
plot(short_exit ? 1 : 0, "short_exit")
